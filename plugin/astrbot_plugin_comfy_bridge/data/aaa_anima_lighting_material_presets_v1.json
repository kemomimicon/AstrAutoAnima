{
  "schema_version": "1.0",
  "library_id": "aaa_anima_lighting_material_core_v1",
  "library_name": "AAA Anima 光影与材质预设库",
  "version": "1.0.0",
  "language": "zh-CN",
  "target": [
    "AstrAutoAnima",
    "ComfyUI",
    "Anima"
  ],
  "design": {
    "modular": true,
    "lighting_material_separated": true,
    "quality_prefix_included": false,
    "artist_tags_included": false,
    "character_tags_included": false,
    "scene_tags_included": false,
    "recommended_prompt_style": "danbooru-style tags + concise visual phrases",
    "hard_requirements": [
      "光影与材质必须完全分离",
      "禁止自动加入 masterpiece/best quality/score_* 等质量词",
      "禁止自动加入画师、角色、场景标签",
      "同一时间最多一个 key lighting",
      "同一目标物体默认最多一个 primary material",
      "保持本地可用，不依赖 LLM 或在线 API"
    ]
  },
  "merge_policy": {
    "lighting": {
      "max_key_lighting": 1,
      "max_effect_lighting": 1,
      "allow_key_plus_effect": true,
      "deduplicate_terms": true,
      "conflict_behavior": "reject_or_replace_previous",
      "recommended_order": [
        "key",
        "effect"
      ]
    },
    "material": {
      "max_primary_material_per_target": 1,
      "max_detail_material_per_target": 2,
      "max_surface_effect_per_target": 1,
      "deduplicate_terms": true,
      "conflict_behavior": "reject_or_replace_previous",
      "recommended_order": [
        "primary_material",
        "detail_material",
        "surface_effect"
      ]
    },
    "global": {
      "separator": ", ",
      "do_not_auto_add_quality_tags": true,
      "do_not_auto_add_score_tags": true,
      "do_not_auto_weight": true
    }
  },
