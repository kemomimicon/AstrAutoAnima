# Hub 只在工作站本机监听。对外访问必须经过 HTTPS 或可信 VPN/隧道。
AAH_HOST=127.0.0.1
AAH_PORT=6278

# 至少 32 个随机字符。不要把真实值提交到 Git。
AAH_ADMIN_TOKEN=replace-with-a-long-random-token

# 普通用户客户端专用，只能读预设与已启用提示词；必须与管理员令牌不同。
AAH_LITE_TOKEN=replace-with-a-different-long-random-token
# 将上面的既有令牌绑定到令牌所有者的 QQ；留空时仍按旧共享令牌处理。
AAH_LITE_TOKEN_QQ=

AAH_ASTRBOT_URL=http://127.0.0.1:6185
AAH_ASTRBOT_API_KEY=
AAH_ASTRBOT_BOT_ID=your-bot-id
AAH_COMFYUI_URL=http://127.0.0.1:8188
AAH_REQUEST_TIMEOUT_SECONDS=4
AAH_REMOTE_JOB_TIMEOUT_SECONDS=1800

# Flutter Web 发布目录；配置后 Hub 会在同一 HTTPS 域名的根路径提供 Web App。
AAH_WEB_ROOT=

# 手动部署请改成实际绝对路径；相对路径以 Hub 启动目录为准。
# 一键向导会自动生成本机绝对路径，不使用此示例推测服务器目录。
AAH_PLUGIN_DIR=astrbot-runtime/data/plugins/astrbot_plugin_comfy_bridge
AAH_PLUGIN_DATA_DIR=astrbot-runtime/data/plugin_data/astrbot_plugin_comfy_bridge
AAH_COMFYUI_ROOT=ComfyUI
AAH_DELIVERY_TARGETS_PATH=
AAH_LITE_USERS_PATH=

# 只有修改过默认文件位置时才需要填写；留空会使用插件数据目录。
AAH_PROMPT_POOL_PATH=
AAH_PRESET_PATH=
AAH_KP_PROMPT_POOL_PATH=
AAH_LORA_CATALOG_PATH=
AAH_PERSONAL_STYLES_PATH=
AAH_CHARACTER_DICTIONARY_PATH=
AAH_CHARACTER_DICTIONARY_EDITS_PATH=
AAH_CHARACTER_FAVORITES_PATH=
