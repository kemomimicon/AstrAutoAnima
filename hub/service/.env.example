# Hub 只在工作站本机监听。对外访问必须经过 HTTPS 或可信 VPN/隧道。
AAH_HOST=127.0.0.1
AAH_PORT=6278

# 至少 32 个随机字符。不要把真实值提交到 Git。
AAH_ADMIN_TOKEN=replace-with-at-least-32-random-characters

# 普通用户客户端专用，只能读预设与已启用提示词；必须与管理员令牌不同。
AAH_LITE_TOKEN=replace-with-a-different-32-character-token
# 将上面的既有令牌绑定到令牌所有者的 QQ；留空时仍按旧共享令牌处理。
AAH_LITE_TOKEN_QQ=123456789

AAH_ASTRBOT_URL=http://127.0.0.1:6185
AAH_ASTRBOT_API_KEY=
AAH_ASTRBOT_BOT_ID=your-bot-id
AAH_COMFYUI_URL=http://127.0.0.1:8188
AAH_REQUEST_TIMEOUT_SECONDS=4
AAH_REMOTE_JOB_TIMEOUT_SECONDS=1800

AAH_PLUGIN_DIR=/workspace/astrbot-runtime/data/plugins/astrbot_plugin_comfy_bridge
AAH_PLUGIN_DATA_DIR=/workspace/astrbot-runtime/data/plugin_data/astrbot_plugin_comfy_bridge
AAH_COMFYUI_ROOT=/workspace/ComfyUI
AAH_DELIVERY_TARGETS_PATH=/workspace/astr-auto-anima-hub-config/delivery_targets.json
AAH_LITE_USERS_PATH=/workspace/astr-auto-anima-hub-config/lite_users.json

# 只有当插件设置中修改过默认文件路径时才需要填写。
AAH_PROMPT_POOL_PATH=
AAH_PRESET_PATH=
